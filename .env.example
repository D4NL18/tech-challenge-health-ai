ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=your-secure-secret-key

# LLM APIs
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui

# ---------------------------------------------------------------------------
# Assistente Medico (Fase 3) - lidas por backend/app/core/settings.py
# Valores de exemplo, sem segredo real. Linhas comentadas: parametro ainda
# decidido por fase futura (F3/F6/F8); descomente quando houver valor.
# ---------------------------------------------------------------------------
# Flag principal: false = rotas /api/v1/assistant/* respondem 501 (AST-050)
ASSISTANT_ENABLED=false
# Fine-tuned usado antes de existir escolha no painel (id de finalista, F3)
# ASSISTANT_DEFAULT_CANDIDATE=qwen25-1_5b
# Escolha do modelo ativo: gs://bucket/objeto em producao; arquivo local em dev
ACTIVE_MODEL_STORE_URI=./data/active_model.json
# healthai-llm (producao) ou llama-swap local (dev)
LLM_SERVICE_URL=http://localhost:8080
# none | cloud_run_id_token
LLM_AUTH_MODE=none
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Postgres local do docker-compose.dev.yml; em producao, pooler do Supabase (modo transacao)
DATABASE_URL=postgresql://healthai:healthai_dev@localhost:5433/healthai_dev
# Conexao direta (migracoes e seed)
DATABASE_DIRECT_URL=postgresql://healthai:healthai_dev@localhost:5433/healthai_dev
# RAG (F6)
# EMBEDDING_MODEL=
# CORPUS_VERSION=
# RAG_MIN_SCORE=
# SLA de exames pendentes em dias (F8, PA-06)
# EXAM_SLA_DAYS=
# Usuario medico de demonstracao: ^[a-z][a-z0-9_-]{2,31}$, sem PII (RIPD 5.4)
DOCTOR_USERNAME=medico-01
DOCTOR_PASSWORD=change-me
